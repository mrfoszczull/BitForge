BasedOnStyle: LLVM
Language: Cpp
Standard: c++03

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 80

BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Never
  BeforeElse: false

PointerAlignment: Right
DerivePointerAlignment: false

SortIncludes: CaseSensitive
